{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [".", "test/compat"],
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": [
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-os-guard",
  "main": "src/index-mutation-gate.ts",
  "compatibility_date": "2026-08-20",
  "vars": {
    "PROJECT_OS_LAYOUT_MODE": "v2",
    "PROJECT_OS_CONTINUITY_MODE": "stable",
    "PROJECT_OS_MUTATION_GATE_MODE": "observe"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_GUARD", "class_name": "ProjectGuard" },
      { "name": "REGISTRY_GUARD", "class_name": "RegistryGuard" }
    ]
  },
  "exports": {
    "ProjectGuard": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    },
    "RegistryGuard": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    }
  }
}
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-os-guard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_GUARD", "class_name": "ProjectGuard" },
      { "name": "REGISTRY_GUARD", "class_name": "RegistryGuard" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectGuard", "RegistryGuard"]
    }
  ]
}
